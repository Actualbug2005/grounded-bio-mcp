# grounded-bio-mcp — environment variables
# Copy to .env (for local dev) or install at /etc/grounded_bio_mcp/env (mode 600) on the LXC.
# See spec §9.5.

# ---------------------------------------------------------------------------
# Upstream service credentials
# ---------------------------------------------------------------------------

# NCBI E-utilities — optional but strongly recommended (raises limit from
# 3 req/s to 10 req/s). Request one at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# EBI requires an email address on every async job submission
# (Clustal Omega, InterProScan). Use a real, monitored inbox.
EBI_EMAIL=

# STRING asks for a contact email in the User-Agent for heavy use
STRING_USER_EMAIL=

# ---------------------------------------------------------------------------
# MCP server transport / auth
# ---------------------------------------------------------------------------

# Bind to localhost on the LXC; the Caddy reverse proxy terminates TLS
# and validates the bearer token on the public side (see spec §9.4).
# Do NOT change to 0.0.0.0 — that bypasses the auth layer.
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8080

# Shared secret. Generate with: openssl rand -hex 32
# Caddy checks this against the Authorization: Bearer <token> header.
MCP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Runtime paths (must exist and be writable by bio-mcp user — spec §9.2)
# ---------------------------------------------------------------------------

# CRISPOR installation and its dedicated venv interpreter
CRISPOR_PATH=/opt/crispor
CRISPOR_PYTHON=/opt/crispor/venv/bin/python

# Pre-built genome indexes for CRISPOR off-target scans (~3 GB each)
GENOME_DIR=/var/lib/grounded_bio_mcp/genomes

# Response cache (optional, controlled by spec §7.2)
CACHE_DIR=/var/lib/grounded_bio_mcp/cache

# Structured log output
LOG_DIR=/var/lib/grounded_bio_mcp/logs
LOG_LEVEL=INFO
